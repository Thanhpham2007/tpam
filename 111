#include <stdio.h>

void nhapMaTran(int a[100][100], int n) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("a[%d][%d] = ", i, j);
            scanf("%d", &a[i][j]);
        }
    }
}

void inBien(int a[100][100], int n) {
    printf("\nCac phan tu tren 4 duong bien:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (i == 0 || i == n - 1 || j == 0 || j == n - 1)
                printf("%4d", a[i][j]);
            else
                printf("    ");
        }
        printf("\n");
    }
}

int tongTrong(int a[100][100], int n) {
    int sum = 0;
    for (int i = 1; i < n - 1; i++) {
        for (int j = 1; j < n - 1; j++) {
            sum += a[i][j];
        }
    }
    return sum;
}

int doiXungCheoChinh(int a[100][100], int n) {
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i][j] != a[j][i])
                return 0;
        }
    }
    return 1;
}

int tongCheo(int a[100][100], int n) {
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum += a[i][i];           // chéo chính
        sum += a[i][n - 1 - i];   // chéo phụ
    }
    if (n % 2 == 1)
        sum -= a[n / 2][n / 2];   // trừ phần tử trung tâm
    return sum;
}

int main() {
    int a[100][100], n;

    do {
        printf("Nhap n (2 <= n <= 100): ");
        scanf("%d", &n);
    } while (n < 2 || n > 100);

    nhapMaTran(a, n);

    inBien(a, n);

    printf("\nTong cac phan tu khong nam tren bien = %d\n", tongTrong(a, n));

    if (doiXungCheoChinh(a, n))
        printf("Ma tran DOI XUNG qua duong cheo chinh\n");
    else
        printf("Ma tran KHONG doi xung qua duong cheo chinh\n");

    printf("Tong duong cheo chinh va cheo phu = %d\n", tongCheo(a, n));

    return 0;
}